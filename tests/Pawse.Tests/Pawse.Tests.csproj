<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Must match Pawse.csproj's TFM to reference it. Compiles anywhere via
         EnableWindowsTargeting (Directory.Build.props); the WindowsDesktop runtime only exists
         on Windows, so the tests EXECUTE on the Windows CI job (ci.yml). -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- xunit.v3 test projects are executables on Microsoft.Testing.Platform; the opt-in
         `dotnet test` needs for that is the "test" block in global.json. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Pawse\Pawse.csproj" />
  </ItemGroup>

</Project>
