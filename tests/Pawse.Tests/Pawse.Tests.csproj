<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Must match Pawse.csproj's TFM to reference it. Compiles anywhere via
         EnableWindowsTargeting; the WindowsDesktop runtime only exists on Windows,
         so the tests EXECUTE on the Windows CI job (ci.yml). -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- net10.0 audits the whole transitive closure, not just direct references, and this
         project's closure is mostly Test.Sdk's. Without this, an advisory against something
         four levels down turns a green build red with no change of our own. -->
    <WarningsNotAsErrors>NU1901;NU1902;NU1903;NU1904;$(WarningsNotAsErrors)</WarningsNotAsErrors>
    <!-- xunit.v3 test projects are executables on Microsoft.Testing.Platform; the opt-in
         `dotnet test` needs for that is the "test" block in global.json. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <!-- Not used by `dotnet test` (that is Microsoft.Testing.Platform, see global.json): these
         two keep the suite visible to VSTest-based runners, as xunit recommends until every
         IDE in use speaks MTP. -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Pawse\Pawse.csproj" />
  </ItemGroup>

</Project>
