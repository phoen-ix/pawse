<Window x:Class="Pawse.UI.ShortcutRecorderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Record a shortcut"
        Width="440" SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <!-- Same chrome as the lock popup: there is no shared resource dictionary in this app
         (App.xaml carries an empty Application.Resources), so the look is inline in both. -->
    <Border CornerRadius="18" Padding="26" BorderThickness="1" BorderBrush="#40FFFFFF">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#F21C1C28" Offset="0" />
                <GradientStop Color="#F2101018" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>
        <StackPanel>
            <TextBlock x:Name="LblTitle" Text="Press your shortcut"
                       Foreground="White" FontSize="17" FontWeight="SemiBold"
                       HorizontalAlignment="Center" />

            <!-- The chord as it builds, then what was actually recorded. -->
            <Border x:Name="PnlChord" CornerRadius="10" Padding="14,10" Margin="0,18,0,0"
                    Background="#1AFFFFFF" BorderThickness="1" BorderBrush="#26FFFFFF">
                <TextBlock x:Name="LblChord" Text="…"
                           Foreground="White" FontSize="22" FontWeight="SemiBold"
                           HorizontalAlignment="Center" TextAlignment="Center"
                           TextWrapping="Wrap" />
            </Border>

            <TextBlock x:Name="LblHint" Margin="0,16,0,0"
                       Foreground="#B3FFFFFF" FontSize="12"
                       HorizontalAlignment="Center" TextAlignment="Center"
                       TextWrapping="Wrap"
                       Text="Hold the keys you want, then let go. Esc cancels." />

            <Button x:Name="BtnCancel" Content="Cancel" Margin="0,18,0,0"
                    Width="100" Height="28" HorizontalAlignment="Center"
                    Click="OnCancel" />
        </StackPanel>
    </Border>
</Window>
