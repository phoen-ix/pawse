<Window x:Class="Pawse.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Pawse.UI"
        Title="Pawse settings"
        Width="460" Height="740"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="#FFF6F7F9">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="Header">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,16,0,6" />
            <Setter Property="Foreground" Value="#FF2B2F36" />
        </Style>
        <Style TargetType="TextBlock" x:Key="Hint">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#FF7A808A" />
            <Setter Property="Margin" Value="22,0,0,4" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,4,0,2" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="22,2,0,2" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="Width" Value="180" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <!-- A TextBox subclass does NOT inherit the implicit TextBox style above, so
             base it explicitly to keep the same indent/width/padding. -->
        <Style TargetType="{x:Type ui:ChordBox}" BasedOn="{StaticResource {x:Type TextBox}}" />
        <Style TargetType="TextBlock" x:Key="Warn" BasedOn="{StaticResource Hint}">
            <Setter Property="Foreground" Value="#FFB00020" />
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="General" Style="{StaticResource Header}" />
                <CheckBox x:Name="ChkStartLocked" Content="Lock immediately when Pawse starts" />
                <CheckBox x:Name="ChkAutostart" Content="Start Pawse when I sign in to Windows" />
                <CheckBox x:Name="ChkBlockMouse" Content="Also block the mouse while locked" />
                <TextBlock Style="{StaticResource Hint}"
                           Text="With mouse blocking on, use a keyboard method to unlock (the hold button needs the mouse)." />

                <TextBlock Text="System keys (while locked)" Style="{StaticResource Header}" />
                <CheckBox x:Name="ChkWinLock" Content="Block Win+L (lock-screen shortcut)" />
                <TextBlock Style="{StaticResource Hint}"
                           Text="Works on every Windows edition, no admin. Disables Win+L only while Pawse is locked; restored on unlock." />
                <CheckBox x:Name="ChkSecureAttention" Content="Block Ctrl+Alt+Del" />
                <CheckBox x:Name="ChkLaunchMedia" Content="Block browser / calculator / media keys" />
                <TextBlock x:Name="LblFilterStatus" Style="{StaticResource Hint}" />

                <TextBlock Text="Lock hotkey" Style="{StaticResource Header}" />
                <CheckBox x:Name="ChkLockHotkey" Content="Lock with a keyboard shortcut" />
                <StackPanel Orientation="Horizontal" Margin="22,2,0,2">
                    <ui:ChordBox x:Name="TxtLockHotkey" Width="180" Margin="0" />
                    <Button Content="Clear" Width="60" Height="24" Margin="8,0,0,0"
                            VerticalAlignment="Center" Click="OnClearLockHotkey" />
                </StackPanel>
                <TextBlock Style="{StaticResource Hint}"
                           Text="Click the box and press your shortcut (e.g. Ctrl+Alt+L). The Windows key may open Start, but the shortcut is still captured." />
                <TextBlock x:Name="LblLockHotkeyWarn" Style="{StaticResource Warn}" />

                <TextBlock Text="Unlock - keyboard chord" Style="{StaticResource Header}" />
                <CheckBox x:Name="ChkChord" Content="Unlock with a key combination" />
                <StackPanel Orientation="Horizontal" Margin="22,2,0,2">
                    <ui:ChordBox x:Name="TxtChord" Width="180" Margin="0" />
                    <Button Content="Clear" Width="60" Height="24" Margin="8,0,0,0"
                            VerticalAlignment="Center" Click="OnClearChord" />
                </StackPanel>
                <TextBlock Style="{StaticResource Hint}"
                           Text="Click the box and press your shortcut (e.g. Ctrl+Shift+U)." />
                <TextBlock x:Name="LblChordWarn" Style="{StaticResource Warn}" />

                <TextBlock Text="Unlock - passphrase" Style="{StaticResource Header}" />
                <CheckBox x:Name="ChkPassphrase" Content="Unlock by typing a passphrase" />
                <TextBox x:Name="TxtPassphrase" />
                <CheckBox x:Name="ChkResetWrong" Content="A wrong key restarts the passphrase" Margin="22,2,0,2" />

                <TextBlock Text="Unlock - mouse hold" Style="{StaticResource Header}" />
                <CheckBox x:Name="ChkMouseHold" Content="Unlock by holding the popup button" />
                <StackPanel Orientation="Horizontal" Margin="22,2,0,2">
                    <TextBlock Text="Hold for" VerticalAlignment="Center" />
                    <TextBox x:Name="TxtHoldMs" Width="70" Margin="8,0" />
                    <TextBlock Text="milliseconds" VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Text="Unlock - auto timer" Style="{StaticResource Header}" />
                <CheckBox x:Name="ChkTimer" Content="Automatically unlock after a delay" />
                <StackPanel Orientation="Horizontal" Margin="22,2,0,2">
                    <TextBlock Text="Unlock after" VerticalAlignment="Center" />
                    <TextBox x:Name="TxtTimerSeconds" Width="70" Margin="8,0" />
                    <TextBlock Text="seconds" VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Text="Lock popup" Style="{StaticResource Header}" />
                <CheckBox x:Name="ChkOverlay" Content="Show the floating lock popup" />
                <StackPanel Orientation="Horizontal" Margin="22,6,0,2">
                    <TextBlock Text="Display" VerticalAlignment="Center" Width="70" />
                    <ComboBox x:Name="CmbMonitor" Width="220" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="22,6,0,2">
                    <TextBlock Text="Opacity" VerticalAlignment="Center" Width="70" />
                    <Slider x:Name="SldOpacity" Minimum="0.3" Maximum="1.0" Width="200"
                            TickFrequency="0.05" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="22,6,0,2">
                    <TextBlock Text="Vertical" VerticalAlignment="Center" Width="70" />
                    <Slider x:Name="SldVertical" Minimum="0" Maximum="100" Width="200"
                            TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <TextBlock x:Name="VersionLabel" VerticalAlignment="Center" Margin="0,0,14,0" Foreground="#FF9AA0AA" />
            <Button Content="Cancel" Width="92" Height="30" Margin="0,0,8,0" Click="OnCancel" />
            <Button Content="Save" Width="92" Height="30" Click="OnSave" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
