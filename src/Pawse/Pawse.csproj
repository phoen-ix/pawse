<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Pawse</RootNamespace>
    <AssemblyName>Pawse</AssemblyName>
    <Product>Pawse</Product>
    <!-- Placeholder only: CI injects the real version via -p:Version (release.yml).
         Local builds show an obviously-dev v0.0.0 instead of a stale-looking number. -->
    <Version>0.0.0-dev</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Embed the same paw icon the installer uses, so Pawse.exe (and its WPF
         windows / taskbar) show it instead of a generic exe icon. -->
    <ApplicationIcon>../../packaging/pawse.ico</ApplicationIcon>

    <!-- Lets this Windows-desktop (WPF/WinForms) project compile on Linux CI/dev
         boxes for type-checking. The runnable exe is still built on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- The code parses/formats with invariant culture throughout; dropping the ICU
         bundle takes a chunk out of the self-contained single-file build. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- ...but do NOT inherit the PredefinedCulturesOnly=true that InvariantGlobalization
         turns on by default. With it on, constructing any non-invariant CultureInfo throws
         CultureNotFoundException - and WPF builds one from the ACTIVE KEYBOARD LAYOUT when it
         commits a typed character. On a machine whose layout is not en-US that throw happened
         on every keystroke, landed in App's DispatcherUnhandledException handler (which marks
         it handled), and the character silently vanished. Backspace, Delete, the arrow keys
         and paste run through EditingCommands, which consult no culture, so editing kept
         working and the Settings window looked half-alive.
         False keeps ICU out - cultures still resolve to invariant DATA - but makes them
         constructible instead of fatal. Everything here is parsed and formatted with
         CultureInfo.InvariantCulture explicitly, so behaviour does not change. -->
    <PredefinedCulturesOnly>false</PredefinedCulturesOnly>

    <!-- We set PerMonitorV2 DPI awareness in app.manifest (WPF needs process-level
         awareness for the overlay's physical-pixel placement). The WinForms analyzer
         flags the manifest DPI settings, but since we boot through WPF and never call
         SetHighDpiMode there is no conflict - suppress that one warning.
         Both IDs on purpose: the analyzer ships in the Microsoft.WindowsDesktop.App.Ref
         targeting pack, so the ID is versioned by the TFM - WFAC010 up to net8.0, renamed
         to WFO0003 from net9.0 on. Dropping either one breaks a build on that TFM, and
         TreatWarningsAsErrors below turns the miss into an error rather than a warning. -->
    <NoWarn>$(NoWarn);WFAC010;WFO0003</NoWarn>

    <!-- net10.0 flips NuGetAuditMode from "direct" to "all", so restore starts reporting
         advisories against the whole transitive closure. With TreatWarningsAsErrors that
         would turn an advisory published by a third party into a red build on a day nobody
         touched this repo. Keep the audit (it is worth seeing) but as a warning. -->
    <WarningsNotAsErrors>NU1901;NU1902;NU1903;NU1904;$(WarningsNotAsErrors)</WarningsNotAsErrors>
  </PropertyGroup>

  <!-- The Microsoft Store build: dotnet publish -p:PawseStore=true, packed into an MSIX by
       packaging/msix/build-msix.ps1. The Store owns updates, so the updater is not hidden but
       left OUT - the files below are not compiled at all, and anything still calling into
       them fails the build instead of shipping. Start-at-sign-in becomes a StartupTask, which
       is what the Windows-versioned TFM is for: it brings the WinRT projection
       (StartupTask, ApplicationData). Only this build pays for that projection - it is
       several MB, and the framework-dependent build is a 0.3 MB launcher.
       Convention: *.Store.cs files exist only in this build; the Compile Remove list is
       what exists only outside it. obj/ and bin/ are per-TFM, so both flavors build from
       one checkout. -->
  <PropertyGroup Condition="'$(PawseStore)' == 'true'">
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <DefineConstants>$(DefineConstants);STORE</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(PawseStore)' == 'true'">
    <Compile Remove="Core\UpdateCheck.cs;Core\SelfReplace.cs;Core\Autostart.cs;App.Updates.cs;UI\SettingsWindow.Updates.cs;Core\UninstallCleanup.cs;App.Uninstall.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(PawseStore)' != 'true'">
    <Compile Remove="**\*.Store.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- WMI, used only for the Keyboard Filter block (browser/calculator/media keys) in
         Core/KeyboardFilterGuard.cs. Windows-only at runtime; restores fine on Linux. -->
    <PackageReference Include="System.Management" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Pawse.Tests" />
  </ItemGroup>

</Project>
